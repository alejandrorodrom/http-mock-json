  "api/:tenantId/matrix-orders": {
    "store": {
      "id": "matrix-orders",
      "key": { "fields": ["tenantId", "id"] },
      "seed": [
        { "tenantId": "acme", "id": 1, "status": "open", "total": 10 },
        { "tenantId": "acme", "id": 2, "status": "closed", "total": 20 }
      ],
      "template": {
        "tenantId": "",
        "id": 0,
        "status": "open",
        "total": 0
      },
      "persist": true,
      "list": {
        "page": { "query": "page", "default": 1 },
        "pageSize": { "default": 10, "max": 50 },
        "sort": { "fields": ["id", "status"], "default": "id:asc" },
        "filter": {
          "fields": [
            { "field": "status", "query": "status", "op": "eq" }
          ]
        }
      },
      "relations": {
        "items": {
          "type": "many",
          "store": "matrix-items",
          "join": { "from": ["tenantId", "orderId"] },
          "embed": { "as": "items" }
        }
      }
    },
    "GET": {
      "nameResponse": "list",
      "responses": [{ "name": "list", "statusCode": 200, "action": "list" }]
    },
    "POST": {
      "nameResponse": "create",
      "responses": [{ "name": "create", "statusCode": 201, "action": "create" }]
    }
  },
  "api/:tenantId/matrix-orders/:id": {
    "store": { "id": "matrix-orders" },
    "GET": {
      "nameResponse": "get",
      "responses": [{ "name": "get", "statusCode": 200, "action": "get" }]
    },
    "DELETE": {
      "nameResponse": "remove",
      "responses": [{ "name": "remove", "statusCode": 204, "action": "delete" }]
    }
  },
  "api/:tenantId/matrix-items": {
    "store": {
      "id": "matrix-items",
      "key": { "fields": ["tenantId", "id"] },
      "seed": [
        {
          "tenantId": "acme",
          "id": 1,
          "orderId": 1,
          "sku": "TEA",
          "qty": 1
        },
        {
          "tenantId": "acme",
          "id": 2,
          "orderId": 1,
          "sku": "MUG",
          "qty": 2
        }
      ],
      "template": {
        "tenantId": "",
        "id": 0,
        "orderId": 0,
        "sku": "",
        "qty": 1
      },
      "unique": {
        "fields": [
          {
            "fields": ["tenantId", "sku"],
            "conflict": { "response": "duplicate-sku" }
          }
        ]
      },
      "persist": true,
      "list": {
        "page": { "query": "page", "default": 1 },
        "pageSize": { "default": 20, "max": 100 },
        "filter": {
          "fields": [
            { "field": "orderId", "query": "orderId", "op": "eq" },
            { "field": "sku", "query": "sku", "op": "eq" }
          ]
        }
      },
      "relations": {
        "orderRef": {
          "store": "matrix-orders",
          "join": {
            "from": ["tenantId", "orderId"],
            "to": ["tenantId", "id"]
          },
          "required": true,
          "onDelete": "cascade",
          "embed": { "as": "order" },
          "conflict": {
            "response": "invalid-order",
            "detail": {
              "code": "INVALID_ORDER",
              "field": "{{field}}",
              "value": "{{value}}"
            }
          }
        }
      }
    },
    "GET": {
      "nameResponse": "list",
      "responses": [{ "name": "list", "statusCode": 200, "action": "list" }]
    },
    "POST": {
      "nameResponse": "create",
      "request": {
        "body": {
          "orderId": { "type": "number", "min": 1 },
          "sku": { "type": "string", "minLength": 1 },
          "qty": { "type": "number", "min": 1 }
        },
        "invalidResponse": "validation-error"
      },
      "responses": [
        {
          "name": "validation-error",
          "statusCode": 422,
          "body": { "code": "VALIDATION", "message": "Invalid item" }
        },
        {
          "name": "duplicate-sku",
          "statusCode": 409,
          "body": { "code": "DUPLICATE_SKU", "field": "{{field}}" }
        },
        {
          "name": "invalid-order",
          "statusCode": 422,
          "body": {
            "code": "INVALID_ORDER",
            "field": "{{field}}",
            "value": "{{value}}"
          }
        },
        { "name": "create", "statusCode": 201, "action": "create" }
      ]
    }
  },
  "api/:tenantId/matrix-items/:id": {
    "store": { "id": "matrix-items" },
    "GET": {
      "nameResponse": "get",
      "responses": [{ "name": "get", "statusCode": 200, "action": "get" }]
    },
    "PATCH": {
      "nameResponse": "patch",
      "responses": [
        {
          "name": "duplicate-sku",
          "statusCode": 409,
          "body": { "code": "DUPLICATE_SKU", "field": "{{field}}" }
        },
        {
          "name": "invalid-order",
          "statusCode": 422,
          "body": {
            "code": "INVALID_ORDER",
            "field": "{{field}}",
            "value": "{{value}}"
          }
        },
        { "name": "patch", "statusCode": 200, "action": "patch" }
      ]
    },
    "DELETE": {
      "nameResponse": "remove",
      "responses": [{ "name": "remove", "statusCode": 204, "action": "delete" }]
    }
  },
  "api/authors-mx": {
    "store": {
      "id": "authors-mx",
      "key": "id",
      "softDelete": true,
      "seed": [
        { "id": 1, "name": "Ada" },
        { "id": 2, "name": "Grace" }
      ],
      "template": { "id": 0, "name": "" },
      "relations": {
        "articles": {
          "type": "many",
          "store": "articles-mx",
          "join": { "from": "authorId" },
          "embed": { "as": "articles" }
        }
      }
    },
    "GET": {
      "nameResponse": "list",
      "responses": [{ "name": "list", "statusCode": 200, "action": "list" }]
    }
  },
  "api/authors-mx/:id": {
    "store": { "id": "authors-mx" },
    "GET": {
      "nameResponse": "get",
      "responses": [{ "name": "get", "statusCode": 200, "action": "get" }]
    },
    "DELETE": {
      "nameResponse": "remove",
      "responses": [
        {
          "name": "has-articles",
          "statusCode": 409,
          "body": { "code": "HAS_ARTICLES" }
        },
        { "name": "remove", "statusCode": 204, "action": "delete" }
      ]
    },
    "POST": {
      "nameResponse": "restore",
      "responses": [{ "name": "restore", "statusCode": 200, "action": "restore" }]
    }
  },
  "api/articles-mx": {
    "store": {
      "id": "articles-mx",
      "key": "id",
      "softDelete": true,
      "seed": [
        {
          "id": 1,
          "title": "Hello",
          "slug": "hello",
          "status": "published",
          "authorId": 1
        },
        {
          "id": 2,
          "title": "Draft",
          "slug": "draft",
          "status": "draft",
          "authorId": 1
        },
        {
          "id": 3,
          "title": "Grace note",
          "slug": "grace",
          "status": "published",
          "authorId": 2
        }
      ],
      "template": {
        "id": 0,
        "title": "",
        "slug": "",
        "status": "draft",
        "authorId": 0
      },
      "unique": {
        "fields": [
          {
            "field": "slug",
            "conflict": { "response": "duplicate-slug" }
          }
        ]
      },
      "list": {
        "page": { "query": "page", "default": 1 },
        "pageSize": { "default": 10, "max": 50 },
        "sort": { "fields": ["id", "status", "title"], "default": "id:asc" },
        "filter": {
          "fields": [
            { "field": "status", "query": "status", "op": "eq" },
            { "field": "authorId", "query": "authorId", "op": "eq" }
          ],
          "search": { "query": "q", "fields": ["title", "slug"] }
        }
      },
      "relations": {
        "authorId": {
          "store": "authors-mx",
          "join": { "from": "authorId", "to": "id" },
          "required": true,
          "onDelete": {
            "action": "restrict",
            "conflict": { "response": "has-articles" }
          },
          "embed": { "as": "author" },
          "conflict": {
            "response": "invalid-author",
            "detail": {
              "code": "INVALID_AUTHOR",
              "field": "{{field}}",
              "value": "{{value}}"
            }
          }
        }
      }
    },
    "GET": {
      "nameResponse": "list",
      "responses": [{ "name": "list", "statusCode": 200, "action": "list" }]
    },
    "POST": {
      "nameResponse": "create",
      "request": {
        "body": {
          "title": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "minLength": 1 },
          "authorId": { "type": "number", "min": 1 },
          "status?": { "type": "string", "enum": ["draft", "published"] }
        },
        "invalidResponse": "validation-error"
      },
      "responses": [
        {
          "name": "validation-error",
          "statusCode": 422,
          "body": { "code": "VALIDATION" }
        },
        {
          "name": "duplicate-slug",
          "statusCode": 409,
          "body": { "code": "DUPLICATE_SLUG" }
        },
        {
          "name": "invalid-author",
          "statusCode": 422,
          "body": {
            "code": "INVALID_AUTHOR",
            "field": "{{field}}",
            "value": "{{value}}"
          }
        },
        { "name": "create", "statusCode": 201, "action": "create" }
      ]
    }
  },
