      ]
    },
    "DELETE": {
      "nameResponse": "remove",
      "responses": [{ "name": "remove", "statusCode": 204, "action": "delete" }]
    },
    "POST": {
      "nameResponse": "restore",
      "responses": [
        {
          "name": "duplicate-slug",
          "statusCode": 409,
          "body": { "code": "DUPLICATE_SLUG" }
        },
        {
          "name": "invalid-author",
          "statusCode": 422,
