{
  "api/orgs/:orgId/projects": {
    "store": {
      "id": "projects",
      "key": {
        "fields": ["orgId", "id"],
        "conflict": {
          "response": "duplicate-key"
        }
      },
      "seed": [
        {
          "orgId": "org_acme",
          "id": 1,
          "name": "Website Redesign",
          "slug": "website",
          "status": "active",
          "ownerEmail": "lead@acme.com"
        }
      ],
      "template": {
        "orgId": "",
        "id": 0,
        "name": "",
        "slug": "",
        "status": "active",
        "ownerEmail": ""
      },
      "unique": {
        "fields": [
          {
            "field": "slug",
            "conflict": {
              "response": "slug-taken",
              "detail": {
                "field": "{{field}}",
                "value": "{{value}}"
              }
            }
          }
        ],
        "conflict": {
          "response": "duplicate-fields",
          "detail": {
            "campo": "{{field}}",
            "valor": "{{value}}"
          }
        }
      },
      "persist": true
    },
    "GET": {
      "nameResponse": "list",
      "responses": [
        {
          "name": "forbidden-org",
          "statusCode": 403,
          "match": { "params": { "orgId": "org_blocked" } },
          "body": {
            "code": "ORG_FORBIDDEN",
            "message": "You cannot access this organization"
          }
        },
        {
          "name": "board-view",
          "statusCode": 200,
          "match": { "query": { "view": "board" } },
          "headers": {
            "X-View": "board"
          },
          "body": {
            "view": "board",
            "columns": ["backlog", "doing", "done"],
            "source": "static-match"
          }
        },
        {
          "name": "list",
          "statusCode": 200,
          "action": "list",
          "headers": {
            "X-Store-Action": "list"
          }
        }
      ]
    },
    "POST": {
      "nameResponse": "create",
      "request": {
        "body": {
          "name": { "type": "string", "minLength": 3, "maxLength": 80 },
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "ownerEmail": { "type": "string", "format": "email" },
          "status?": { "type": "string", "enum": ["active", "paused"] }
        },
        "invalidResponse": "validation-error",
        "errorFormat": "array",
        "errorDetail": {
          "field": "{{path}}",
          "message": "{{message}}"
        }
      },
      "responses": [
        {
          "name": "forbidden-org",
          "statusCode": 403,
          "match": { "params": { "orgId": "org_blocked" } },
          "body": {
            "code": "ORG_FORBIDDEN",
            "message": "You cannot create projects in this organization"
          }
        },
        {
          "name": "validation-error",
          "statusCode": 422,
          "body": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid project payload",
            "errors": []
          }
        },
        {
          "name": "slug-taken",
          "statusCode": 409,
          "body": {
            "code": "SLUG_TAKEN",
            "errors": "{{conflicts}}"
          }
        },
        {
          "name": "duplicate-fields",
          "statusCode": 409,
          "body": {
            "code": "DUPLICATE_FIELDS",
            "errors": "{{conflicts}}"
          }
        },
        {
          "name": "duplicate-key",
          "statusCode": 409,
          "body": {
            "code": "DUPLICATE_KEY",
            "message": "Project id already exists for organization"
          }
        },
        {
          "name": "create",
          "statusCode": 201,
          "action": "create",
          "headers": {
            "X-Store-Action": "create"
          }
        }
      ]
    }
  },
  "api/orgs/:orgId/projects/:id": {
    "store": { "id": "projects" },
    "GET": {
      "nameResponse": "get",
      "responses": [
        {
          "name": "forbidden-org",
          "statusCode": 403,
          "match": { "params": { "orgId": "org_blocked" } },
          "body": { "code": "ORG_FORBIDDEN" }
        },
        {
          "name": "get",
          "statusCode": 200,
          "action": "get",
          "headers": {
            "X-Store-Action": "get"
          }
        }
      ]
    },
    "PATCH": {
      "nameResponse": "patch",
      "request": {
        "body": {
          "name?": { "type": "string", "minLength": 3, "maxLength": 80 },
          "status?": { "type": "string", "enum": ["active", "paused", "archived"] },
          "ownerEmail?": { "type": "string", "format": "email" }
        },
        "invalidResponse": "validation-error"
      },
      "responses": [
        {
          "name": "validation-error",
          "statusCode": 422,
          "body": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid project patch",
            "errors": []
          }
        },
        {
          "name": "slug-taken",
          "statusCode": 409,
          "body": {
            "code": "SLUG_TAKEN",
            "errors": "{{conflicts}}"
          }
        },
        {
          "name": "duplicate-fields",
          "statusCode": 409,
          "body": {
            "code": "DUPLICATE_FIELDS",
            "errors": "{{conflicts}}"
          }
        },
        {
          "name": "duplicate-key",
          "statusCode": 409,
          "body": { "code": "DUPLICATE_KEY" }
        },
        {
          "name": "archived-static",
          "statusCode": 409,
          "match": { "body": { "status": "archived" } },
          "body": {
            "code": "ARCHIVE_VIA_STORE_DISABLED",
            "message": "Use the archive endpoint instead of PATCH status=archived"
          }
        },
        {
          "name": "patch",
          "statusCode": 200,
          "action": "patch"
        }
      ]
    },
    "DELETE": {
      "nameResponse": "remove",
      "responses": [
        {
          "name": "forbidden-org",
          "statusCode": 403,
          "match": { "params": { "orgId": "org_blocked" } },
          "body": { "code": "ORG_FORBIDDEN" }
        },
        {
          "name": "remove",
          "statusCode": 204,
          "action": "delete"
        }
      ]
    }
  },
  "api/orgs/:orgId/projects/:projectId/tasks": {
    "store": {
      "id": "tasks",
      "key": {
        "fields": ["orgId", "projectId", "id"]
      },
      "seed": [
        {
          "orgId": "org_acme",
          "projectId": 1,
          "id": 1,
          "title": "Kickoff",
          "status": "done",
          "assignee": "lead@acme.com"
        }
      ],
      "template": {
        "orgId": "",
        "projectId": 0,
        "id": 0,
        "title": "",
        "status": "todo",
        "assignee": ""
      },
      "unique": ["title"],
      "persist": true
    },
    "GET": {
      "nameResponse": "list",
      "responses": [
        {
          "name": "list",
          "statusCode": 200,
          "action": "list"
        }
      ]
    },
    "POST": {
      "nameResponse": "create",
      "request": {
        "body": {
          "title": { "type": "string", "minLength": 2, "maxLength": 120 },
          "assignee": { "type": "string", "format": "email" },
          "status?": { "type": "string", "enum": ["todo", "doing", "done"] }
        },
        "invalidResponse": "validation-error"
      },
      "responses": [
        {
          "name": "validation-error",
          "statusCode": 422,
          "body": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid task payload",
            "errors": []
          }
        },
        {
          "name": "create",
          "statusCode": 201,
          "action": "create"
        }
      ]
    }
  },
  "api/orgs/:orgId/projects/:projectId/tasks/:id": {
    "store": { "id": "tasks" },
    "GET": {
      "nameResponse": "get",
      "responses": [
        {
          "name": "get",
          "statusCode": 200,
          "action": "get"
        }
      ]
    },
    "PATCH": {
      "nameResponse": "patch",
      "request": {
        "body": {
          "title?": { "type": "string", "minLength": 2, "maxLength": 120 },
          "status?": { "type": "string", "enum": ["todo", "doing", "done"] },
          "assignee?": { "type": "string", "format": "email" }
        },
        "invalidResponse": "validation-error"
      },
      "responses": [
        {
          "name": "validation-error",
          "statusCode": 422,
          "body": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid task patch",
            "errors": []
          }
        },
        {
          "name": "patch",
          "statusCode": 200,
          "action": "patch"
        }
      ]
    },
    "DELETE": {
      "nameResponse": "remove",
      "responses": [
        {
          "name": "remove",
          "statusCode": 204,
          "action": "delete"
        }
      ]
    }
  }
}
