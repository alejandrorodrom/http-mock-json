{
  "api/users": {
    "store": {
      "id": "users",
      "key": "id",
      "softDelete": true,
      "seed": [
        {
          "id": 1,
          "name": "Ada"
        },
        {
          "id": 2,
          "name": "Grace"
        },
        {
          "id": 3,
          "name": "Solo"
        }
      ],
      "template": {
        "id": 0,
        "name": ""
      },
      "relations": {
        "posts": {
          "type": "many",
          "store": "posts",
          "join": {
            "from": "userId"
          },
          "embed": {
            "as": "posts"
          }
        }
      }
    },
    "GET": {
      "nameResponse": "list",
      "responses": [
        {
          "name": "list",
          "statusCode": 200,
          "action": "list"
        }
      ]
    },
    "POST": {
      "nameResponse": "create",
      "responses": [
        {
          "name": "create",
          "statusCode": 201,
          "action": "create"
        }
      ]
    }
  },
  "api/users/:id": {
    "store": {
      "id": "users"
    },
    "GET": {
      "nameResponse": "get",
      "responses": [
        {
          "name": "get",
          "statusCode": 200,
          "action": "get"
        }
      ]
    },
    "DELETE": {
      "nameResponse": "remove",
      "responses": [
        {
          "name": "has-posts",
          "statusCode": 409,
          "body": {
            "code": "HAS_POSTS",
            "errores": "{{conflicts}}"
          }
        },
        {
          "name": "remove",
          "statusCode": 204,
          "action": "delete"
        }
      ]
    },
    "POST": {
      "nameResponse": "restore",
      "responses": [
        {
          "name": "restore",
          "statusCode": 200,
          "action": "restore"
        }
      ]
    }
  },
  "api/posts": {
    "store": {
      "id": "posts",
      "key": "id",
      "softDelete": true,
      "seed": [
        {
          "id": 1,
          "title": "Hello",
          "userId": 1
        },
        {
          "id": 2,
          "title": "World",
          "userId": 2
        }
      ],
      "template": {
        "id": 0,
        "title": "",
        "userId": 0
      },
      "relations": {
        "userId": {
          "store": "users",
          "required": true,
          "onDelete": {
            "action": "restrict",
            "conflict": {
              "response": "has-posts",
              "detail": {
                "code": "HAS_POSTS",
                "field": "{{field}}",
                "value": "{{value}}"
              }
            }
          },
          "embed": {
            "as": "user"
          },
          "conflict": {
            "response": "invalid-user",
            "detail": {
              "code": "INVALID_USER",
              "field": "{{field}}",
              "value": "{{value}}"
            }
          }
        }
      }
    },
    "GET": {
      "nameResponse": "list",
      "responses": [
        {
          "name": "list",
          "statusCode": 200,
          "action": "list"
        }
      ]
    },
    "POST": {
      "nameResponse": "create",
      "responses": [
        {
          "name": "invalid-user",
          "statusCode": 422,
          "body": {
            "code": "INVALID_USER",
            "errores": "{{conflicts}}"
          }
        },
        {
          "name": "create",
          "statusCode": 201,
          "action": "create"
        }
      ]
    }
  },
