{
  "api/matrix/json": {
    "POST": {
      "nameResponse": "ok",
      "request": {
        "as": "json",
        "payload": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 5,
            "maxLength": 64,
            "message": "bad email"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "messages": {
              "pattern": "code pattern failed"
            }
          },
          "age": {
            "type": "number",
            "min": 18,
            "max": 120
          },
          "active": "boolean",
          "role": {
            "type": "string",
            "enum": ["admin", "user"]
          },
          "profile": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string",
                "minLength": 2
              },
              "zip?": {
                "type": "string",
                "pattern": "^\\d{5}$"
              }
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "headers": {
          "x-client": {
            "type": "string",
            "minLength": 2
          }
        },
        "error": {
          "response": "invalid",
          "format": "array"
        }
      },
      "responses": [
        {
          "name": "ok",
          "statusCode": 200,
          "body": { "mode": "json" }
        },
        {
          "name": "invalid",
          "statusCode": 400,
          "body": { "message": "json invalid" }
        }
      ]
    }
  },
  "api/matrix/json-auto": {
    "POST": {
      "nameResponse": "ok",
      "request": {
        "payload": {
          "name": {
            "type": "string",
            "minLength": 2
          }
        },
        "error": {
          "response": "invalid"
        }
      },
      "responses": [
        {
          "name": "ok",
          "statusCode": 200,
          "body": { "mode": "json-auto" }
        },
        {
          "name": "invalid",
          "statusCode": 400,
          "body": { "message": "json-auto invalid" }
        }
      ]
    }
  },
  "api/matrix/form": {
    "POST": {
      "nameResponse": "ok",
      "request": {
        "as": "form",
        "payload": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "pattern": "^[a-z0-9_]+$"
          },
          "age": {
            "type": "number",
            "min": 1,
            "max": 150
          },
          "newsletter": "boolean",
          "plan": {
            "type": "string",
            "enum": ["free", "pro"]
          }
        },
        "error": {
          "response": "invalid",
          "format": "map"
        }
      },
      "responses": [
        {
          "name": "ok",
          "statusCode": 200,
          "body": { "mode": "form" }
        },
        {
          "name": "invalid",
          "statusCode": 400,
          "body": { "message": "form invalid" }
        }
      ]
    }
  },
  "api/matrix/multipart": {
    "POST": {
      "nameResponse": "ok",
      "request": {
        "as": "multipart",
        "payload": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "count": {
            "type": "number",
            "min": 1,
            "max": 10
          },
          "avatar": {
            "type": "file",
            "format": ["png", "jpeg"],
            "maxSize": 64,
            "minSize": 4,
            "requireFilename": true,
            "messages": {
              "format": "avatar mime failed",
              "maxSize": "avatar too big",
              "minSize": "avatar too small",
              "requireFilename": "avatar needs name"
            }
          },
          "docs": {
            "type": "file",
            "format": "pdf",
            "minItems": 1,
            "maxItems": 2,
            "maxSize": 128
          },
          "banner?": {
            "type": "file",
            "format": "image/*",
            "maxSize": 128
          }
        },
        "error": {
          "response": "invalid",
          "format": "array"
        }
      },
      "responses": [
        {
          "name": "ok",
          "statusCode": 201,
          "body": { "mode": "multipart" }
        },
        {
          "name": "invalid",
          "statusCode": 400,
          "body": { "message": "multipart invalid" }
        }
      ]
    }
  },
  "api/matrix/raw": {
    "PUT": {
      "nameResponse": "ok",
      "request": {
        "as": "raw",
        "payload": {
          "type": "file",
          "format": "image/*",
          "minSize": 8,
          "maxSize": 128
        },
        "error": {
          "response": "invalid"
        }
      },
      "responses": [
        {
          "name": "ok",
          "statusCode": 200,
          "body": { "mode": "raw" }
        },
        {
          "name": "invalid",
          "statusCode": 415,
          "body": { "message": "raw invalid" }
        }
      ]
    }
  },
  "api/matrix/raw-pdf": {
    "PUT": {
      "nameResponse": "ok",
      "request": {
        "as": "raw",
        "payload": {
          "type": "file",
          "format": "pdf",
          "minSize": 1
        },
        "error": {
          "response": "invalid"
        }
      },
      "responses": [
        {
          "name": "ok",
          "statusCode": 200,
          "body": { "mode": "raw-pdf" }
        },
        {
          "name": "invalid",
          "statusCode": 415,
          "body": { "message": "raw-pdf invalid" }
        }
      ]
    }
  },
  "api/matrix/text": {
    "POST": {
      "nameResponse": "ok",
      "request": {
        "as": "text",
        "payload": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-z]+$",
          "messages": {
            "pattern": "text must be lowercase letters",
            "minLength": "text too short"
          }
        },
        "error": {
          "response": "invalid",
          "format": "array"
        }
      },
      "responses": [
        {
          "name": "ok",
          "statusCode": 200,
          "body": { "mode": "text" }
        },
        {
          "name": "invalid",
          "statusCode": 400,
          "body": { "message": "text invalid" }
        }
      ]
    }
  },
  "api/matrix/as-json-only": {
    "POST": {
      "nameResponse": "ok",
      "request": {
        "as": "json",
        "payload": {
          "ok": "boolean"
        },
        "error": {
          "response": "invalid"
        }
      },
      "responses": [
        {
          "name": "ok",
          "statusCode": 200,
          "body": { "mode": "as-json" }
        },
        {
          "name": "invalid",
          "statusCode": 400,
          "body": { "message": "as-json invalid" }
        }
      ]
    }
  }
}
