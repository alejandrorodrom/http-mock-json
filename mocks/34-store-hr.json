          }
        },
        {
          "orgId": "acme",
          "id": 3,
          "name": "Carla Méndez",
          "email": "carla@acme.com",
          "role": "engineer",
          "status": "leave",
          "salary": 81000,
          "hiredAt": 1580000000,
          "profile": {
            "dept": "platform",
            "level": 4,
