{
  "api/orgs/:orgId/employees": {
    "store": {
      "id": "hr-employees",
      "key": {
        "fields": [
          "orgId",
          "id"
        ],
        "conflict": {
          "response": "duplicate-key"
        }
      },
      "seed": [
        {
          "orgId": "acme",
