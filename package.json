{
  "name": "http-mock-json",
  "version": "4.0.1",
  "description": "Mock your real API in JSON — status codes, errors, validation, latency, and mutable data — so the frontend can develop and test without waiting on a backend.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "node dist/index.js start -p 3500",
    "init": "node dist/index.js init --script --mock",
    "add": "node dist/index.js add",
    "build.tsc": "tsc",
    "build": "npm run build.tsc",
    "dev:init": "npm run build && npm run init",
    "dev:start": "npm run build && npm run start",
    "dev:add": "npm run build && npm run add",
    "test": "npm run test:e2e",
    "test:e2e": "node tests/run-e2e.js",
    "prepublish": "npm run build"
  },
  "type": "commonjs",
  "module": "dist/index.js",
  "bin": {
    "mock-server": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alejandrorodrom/http-mock-json.git"
  },
  "keywords": [
    "mock",
    "mock-server",
    "http-mock",
    "api-mock",
    "json-server",
    "rest",
    "api",
    "testing",
    "frontend",
    "nodejs",
    "typescript",
    "express",
    "dev-server",
    "stub"
  ],
  "author": "Alejandro Rodriguez Romero",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alejandrorodrom/http-mock-json/issues"
  },
  "homepage": "https://github.com/alejandrorodrom/http-mock-json#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "chokidar": "^5.0.0",
    "colorette": "^2.0.20",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "figlet": "^1.9.4",
    "prompts": "^2.4.2",
    "sisteransi": "^1.0.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/figlet": "^1.7.0",
    "@types/node": "^18.19.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^7.0.2"
  }
}
